{
  "name": "@mittwald/mstudio-ext-react-components",
  "version": "1.1.15",
  "type": "module",
  "description": "React components that can be used by mStudio extension developers",
  "homepage": "https://flow.mittwald.de",
  "repository": "https://github.com/mittwald/flow",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/js/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.build.config.ts",
    "clean": "rimraf dist",
    "test:compile": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json"
  },
  "dependencies": {
    "@types/react": "^19.2"
  },
  "devDependencies": {
    "@mittwald/flow-core": "workspace:*",
    "@mittwald/flow-remote-react-components": "workspace:*",
    "@mittwald/typescript-config": "workspace:*",
    "@types/node": "^25.9.3",
    "nx": "^22.7.5",
    "react": "^19.2.8",
    "rimraf": "^6.1.3",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vite-plugin-externalize-deps": "^0.10.0"
  },
  "peerDependencies": {
    "@mittwald/flow-remote-react-components": "workspace:*",
    "react": "^19.2.0"
  }
}
