{
  "name": "@mittwald/flow-remote-core",
  "version": "1.2.0-next.6",
  "type": "module",
  "description": "Core functionality to setup a remote/host environment",
  "homepage": "https://flow.mittwald.de",
  "repository": "https://github.com/mittwald/flow",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/js/index-node.mjs",
      "default": "./dist/js/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.build.config.ts",
    "clean": "rimraf dist",
    "test:compile": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@lit-labs/ssr-dom-shim": "^1.6.0",
    "@mittwald/remote-dom-core": "1.7.0-mittwald.10",
    "@quilted/threads": "^3.3.1",
    "@types/invariant": "^2.2.37",
    "invariant": "^2.2.4",
    "remeda": "^2.43.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mittwald/ext-bridge": "workspace:*",
    "@mittwald/flow-react-components": "workspace:*",
    "@mittwald/typescript-config": "workspace:*",
    "@types/node": "^25.9.3",
    "nx": "^22.7.5",
    "rimraf": "^6.1.3",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@mittwald/ext-bridge": "workspace:*",
    "@mittwald/flow-react-components": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@mittwald/ext-bridge": {
      "optional": true
    }
  }
}
