{
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": false,
    "outDir": "${configDir}/dist/types"
  },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/dist",
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/**/testing/**"
  ],
  "extends": "./tsconfig.json"
}
