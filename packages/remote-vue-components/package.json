{
  "name": "@mittwald/flow-remote-vue-components",
  "version": "1.2.0-next.62",
  "type": "module",
  "description": "Vue components that can be used in a remote environment",
  "homepage": "https://flow.mittwald.de",
  "repository": "https://github.com/mittwald/flow",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/js/index.mjs"
    },
    "./RemoteRoot": {
      "types": "./dist/types/components/RemoteRoot.d.ts",
      "default": "./dist/js/RemoteRoot.mjs"
    }
  },
  "files": [
    "USAGE.md",
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build --config vite.build.config.ts",
    "build:icons": "tsx dev/icons/generate.ts",
    "clean": "rimraf dist src/icons/components/*",
    "test:browser": "vitest run --project=browser --browser.headless --passWithNoTests",
    "test:browser:dev": "vitest dev --project=browser",
    "test:compile": "tsc --noEmit && tsc --noEmit -p tsconfig.vite.json",
    "test:parity": "tsx dev/react-parity/run.ts",
    "test:parity:dev": "vitest dev --config=e2e/react-parity/vitest.config.ts",
    "test:unit": "vitest run --project=unit* --passWithNoTests",
    "test:unit:dev": "vitest dev --project=unit* --passWithNoTests"
  },
  "dependencies": {
    "@mittwald/flow-remote-core": "workspace:*",
    "@mittwald/flow-remote-elements": "workspace:*",
    "@tanstack/table-core": "^8.21.3",
    "country-codes-list": "^2.0.0",
    "mobx": "^6.16.1",
    "remeda": "^2.43.0"
  },
  "devDependencies": {
    "@mittwald/ext-bridge": "workspace:*",
    "@mittwald/flow-components-base": "workspace:*",
    "@mittwald/flow-core": "workspace:*",
    "@mittwald/flow-icons-base": "workspace:*",
    "@mittwald/flow-react-components": "workspace:*",
    "@mittwald/flow-remote-react-components": "workspace:*",
    "@mittwald/flow-remote-react-renderer": "workspace:*",
    "@mittwald/typescript-config": "workspace:*",
    "@quilted/threads": "^3.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "nx": "^22.7.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.2",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.1.11",
    "vue": "~3.5.38"
  },
  "peerDependencies": {
    "@mittwald/ext-bridge": "workspace:*",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@mittwald/ext-bridge": {
      "optional": true
    }
  }
}
