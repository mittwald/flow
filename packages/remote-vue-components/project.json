{
  "implicitDependencies": ["components"],
  "name": "remote-vue-components",
  "projectType": "library",
  "sourceRoot": "packages/remote-vue-components/src",
  "targets": {
    "build": {
      "inputs": ["default", "{projectRoot}/src/**/*"],
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        "^build",
        {
          "projects": ["components"],
          "target": "build:remote-components"
        }
      ]
    },
    "test:browser": {
      "inputs": [
        "default",
        "{projectRoot}/src/**/*",
        "{projectRoot}/dev/**/*",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ]
    },
    "test:parity": {
      "dependsOn": ["build", "^build"],
      "cache": true,
      "inputs": [
        "default",
        "{projectRoot}/e2e/react-parity/**/*",
        "{projectRoot}/dev/react-parity/**/*",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": false
        }
      ]
    }
  }
}
