{
  "name": "@mittwald/flow-icons-pro",
  "version": "1.2.0-next.19",
  "type": "module",
  "description": "Pro iconset for Flow, mittwald’s design system",
  "homepage": "https://flow.mittwald.de",
  "repository": "https://github.com/mittwald/flow",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/esm/components/index.js"
    }
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:icons": "tsx src/dev/generate.ts",
    "clean": "rimraf dist src/components/*"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tabler/icons-react": "^3.46.0"
  },
  "devDependencies": {
    "@fortawesome/sharp-regular-svg-icons": "npm:@fortawesome/free-regular-svg-icons@^7.3.1",
    "@mittwald/flow-icons-base": "workspace:*",
    "@types/react": "^19.2",
    "react": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12"
  },
  "peerDependencies": {
    "@fortawesome/sharp-regular-svg-icons": "^7.2.0",
    "react": "^19.2.0"
  }
}
