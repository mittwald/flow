{
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // Excluding src/tests and src/transforms shrinks the program to 2 files
    // (cli.ts, cli/args.ts). The native `tsc` (TypeScript 7, aliased as
    // `@typescript/native` — see pnpm-workspace.yaml) does not fall back to
    // its usual automatic @types/* discovery for a program this small under
    // `composite`, so `process` and `node:util` resolve to nothing. Declaring
    // "node" explicitly restores it; the tsconfig.json-only (test:compile)
    // program is unaffected because it is not this small.
    "types": ["node"]
  },
  "exclude": ["src/tests/**/*.ts", "src/transforms/**/*.ts"],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"]
}
