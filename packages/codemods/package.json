    "registry-url": "^7.2.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^25.9.3",
    "@types/semver": "^7.7.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
