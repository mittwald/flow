{
  "implicitDependencies": ["tokens"],
  "name": "components",
  "namedInputs": {
    "components-src": [
      "default",
      "!{projectRoot}/MIGRATION.md",
      "{projectRoot}/src/**/*",
      "!{projectRoot}/src/views/*",
      "!{projectRoot}/src/components/**/view.ts",
      "!{projectRoot}/src/**/*.module.d.scss.ts",
      "!{projectRoot}/src/**/*.module.d.css.ts",
      "!{projectRoot}/src/status/component-status.json",
      "!{projectRoot}/src/status/componentStatus.ts",
      "!{projectRoot}/src/**/*.yaml"
    ]
  },
  "projectType": "library",
  "sourceRoot": "packages/components/src",
  "targets": {
    "build": {
      "cache": true,
      "dependsOn": [
        "build:component-index",
        "build:icons",
        "build:remote-components",
        "build:scss-types",
        "build:status-registry",
        "^build"
      ],
      "inputs": ["components-src"]
    },
    "build:component-index": {
      "cache": true,
      "dependsOn": ["build:docs-properties", "build:status-registry"],
      "inputs": [
        "{projectRoot}/dev/component-index/**/*",
        "!{projectRoot}/dev/component-index/**/*.test.ts",
        "{projectRoot}/dev/status-registry/exportEntries.ts",
        "{projectRoot}/dev/status-registry/buildStatusRegistry.ts",
        "{projectRoot}/dev/status-registry/parseFlrUniversalComponentNames.ts",
        "{projectRoot}/dev/remote-components-generator/config.ts",
        "{projectRoot}/dev/remote-components-generator/lib/docTags.ts",
        "{projectRoot}/src/index/flr-universal.ts",
        "{projectRoot}/package.json",
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": ["{projectRoot}/dist/assets/component-index.json"]
    },
    "build:docs-properties": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "components-src",
        "{projectRoot}/dev/createDocPropertiesJson.ts"
      ],
      "outputs": ["{projectRoot}/dist/assets/doc-properties.json"]
    },
    "build:icons": {
      "cache": true,
      "inputs": [
        "{projectRoot}/dev/icons/**/*",
        "{workspaceRoot}/packages/icons-base/src"
      ],
      "outputs": ["{projectRoot}/src/components/Icon/components/icons/*"]
    },
    "build:remote-components": {
      "cache": true,
      "inputs": [
        "{projectRoot}/dev/remote-components-generator/**/*",
        "components-src"
      ],
      "dependsOn": ["build:docs-properties"],
      "outputs": [
        "{projectRoot}/src/components/**/view.ts",
        "{projectRoot}/src/views/*",
        "{workspaceRoot}/packages/remote-elements/src/auto-generated/**/*",
        "{workspaceRoot}/packages/remote-react-components/src/auto-generated/**/*",
        "{workspaceRoot}/packages/remote-react-renderer/src/auto-generated/**/*"
      ]
    },
    "build:scss-types": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.scss",
        "{projectRoot}/src/**/*.css",
        "{projectRoot}/dev/scss-types/**/*",
        "{projectRoot}/vite.config.ts",
        "{workspaceRoot}/packages/core/src/scssTypes/**/*"
      ],
      "outputs": [
        "{projectRoot}/src/**/*.module.d.scss.ts",
        "{projectRoot}/src/**/*.module.d.css.ts"
      ]
    },
    "build:status-registry": {
      "cache": true,
      "dependsOn": ["build:docs-properties"],
      "inputs": [
        "{projectRoot}/dev/status-registry/**/*",
        "!{projectRoot}/dev/status-registry/**/*.test.ts",
        "{projectRoot}/src/status/types.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/src/components/public.ts",
        "{projectRoot}/src/index/flr-universal.ts",
        "{projectRoot}/src/integrations/**/index.ts",
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": [
        "{projectRoot}/src/status/component-status.json",
        "{projectRoot}/src/status/componentStatus.ts"
      ]
    },
    "test:compile": {
      "cache": true,
      "dependsOn": [
        "^build",
        "build:icons",
        "build:remote-components",
        "build:scss-types",
        "build:status-registry"
      ]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": [
        "^build",
        "build:icons",
        "build:remote-components",
        "build:scss-types",
        "build:status-registry"
      ]
    },
    "test:browser": {
      "dependsOn": [
        {
          "projects": ["stylesheet"],
          "target": "build"
        }
      ]
    },
    "test:browser:dev": {
      "cache": true,
      "dependsOn": [
        {
          "projects": ["stylesheet"],
          "target": "build"
        }
      ]
    }
  }
}
