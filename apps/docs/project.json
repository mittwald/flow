{
  "implicitDependencies": ["tokens", "components"],
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "targets": {
    "build:imports": {
      "cache": true,
      "inputs": ["default", "{projectRoot}/src/content/**/*.mdx"]
    },
    "test:links": {
      "cache": true,
      "inputs": ["default"]
    },
    "build": {
      "dependsOn": [
        "build:imports",
        {
          "projects": ["components"],
          "target": "build:docs-properties"
        },
        "^build"
      ],
      "inputs": [
        "default",
        "^default",
        { "env": "NEXT_BASE_PATH" },
        { "env": "NEXT_PUBLIC_SITE_URL" }
      ]
    },
    "dev": {
      "dependsOn": [
        "build:imports",
        {
          "projects": ["components"],
          "target": "build:docs-properties"
        },
        "^build"
      ]
    }
  }
}
