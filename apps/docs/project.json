{
  "implicitDependencies": ["tokens", "components"],
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "targets": {
    "build:imports": {
      "cache": true,
      "inputs": ["default", "{projectRoot}/src/content/**/*.mdx"],
      "outputs": ["{projectRoot}/src/lib/liveCode/dynamicImports.ts"]
    },
    "build:component-tokens": {
      "cache": true,
      "dependsOn": [
        {
          "projects": ["tokens"],
          "target": "build"
        }
      ],
      "inputs": [
        "{projectRoot}/dev/generateComponentTokens.ts",
        "{projectRoot}/src/lib/componentTokens/buildComponentTokens.ts",
        "{projectRoot}/src/lib/componentTokens/types.ts",
        {
          "dependentTasksOutputFiles": "**/json/*.json",
          "transitive": false
        }
      ],
      "outputs": [
        "{projectRoot}/src/lib/componentTokens/componentTokens.generated.json"
      ]
    },
    "build:scss-types": {
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.scss",
        "{projectRoot}/src/**/*.css",
        "{projectRoot}/dev/generateScssTypes.ts",
        "{workspaceRoot}/packages/core/src/scssTypes/**/*"
      ],
      "outputs": [
        "{projectRoot}/src/**/*.module.d.scss.ts",
        "{projectRoot}/src/**/*.module.d.css.ts"
      ]
    },
    "test:compile": {
      "cache": true,
      "dependsOn": [
        "^build",
        "build:imports",
        "build:scss-types",
        "build:component-tokens"
      ]
    },
    "test:links": {
      "cache": true,
      "inputs": ["default"]
    },
    "test:unit": {
      "cache": true,
      "dependsOn": ["^build", "build:scss-types", "build:component-tokens"]
    },
    "build": {
      "dependsOn": [
        "build:imports",
        "build:scss-types",
        "build:component-tokens",
        {
          "projects": ["components"],
          "target": "build:docs-properties"
        },
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "build:imports",
        "build:scss-types",
        "build:component-tokens",
        {
          "projects": ["components"],
          "target": "build:docs-properties"
        },
        "^build"
      ]
    }
  }
}
