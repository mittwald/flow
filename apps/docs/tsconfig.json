{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@fortawesome/sharp-regular-svg-icons": [
        "./src/app/_lib/withoutProIcons/sharpRegular.ts"
      ]
    },
    "allowArbitraryExtensions": true
  },
  "extends": "@mittwald/typescript-config/nextjs.json",
  "include": [
    "${configDir}/src/**/*.tsx",
    "${configDir}/src/**/*.ts",
    "${configDir}/next-env.d.ts",
    "${configDir}/.next/types/**/*.ts",
    ".next/types/**/*.ts",
    "./types.d.ts"
  ],
  "moduleResolution": "bundler"
}
