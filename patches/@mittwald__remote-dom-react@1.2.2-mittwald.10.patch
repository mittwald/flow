+++ b/build/cjs/host/hooks/props-for-element.cjs
@@ -32,6 +32,11 @@ function usePropsForRemoteElement(element, options) {
     // Assume all event listeners are allowed, and write each one as a conventional
     // Preact callback prop.
     for (const [eventName, listener] of Object.entries(eventListeners)) {
+      // A removed listener reaches the host as an update to `undefined`,
+      // because RemoteReceiver assigns rather than deletes, so the key
+      // outlives it. Wrapping that installs a callable prop that throws
+      // when the event fires.
+      if (!listener) continue;
       resolvedProperties[`on${eventName[0].toUpperCase()}${eventName.slice(1)}`] = wrapEventListenerForCallback(listener);
     }
   }
