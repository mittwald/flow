{
  "name": "@mittwald/flow-project",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "affected:test": "nx affected --targets=test:unit,test:compile",
    "affected:test:browser": "nx affected --targets=test:browser,test:e2e,test:visual",
    "build": "nx run-many --targets=build --exclude docs",
    "clean": "nx reset",
    "postclean": "nx run-many --targets=clean",
    "dev": "nx build:deps $@ && concurrently \"yarn watch $@\" \"yarn nx dev $@\"",
    "dev:init-githooks": "simple-git-hooks",
    "dev:init-merge-drivers": "node .github/scripts/init-merge-drivers.cjs",
    "format": "prettier --write '**/*.{ts,tsx,yaml,yml,json,md,mdx,js,cjs,mjs,css}'",
    "format:check": "prettier --check '**/*.{ts,tsx,yaml,yml,json,md,mdx,js,cjs,mjs,css}'",
    "lint": "eslint . && stylelint '**/*.{css,scss}' && pnpm format:check",
    "prepare": "node .github/scripts/init-merge-drivers.cjs",
    "sync:resolve": "node .github/scripts/sync-resolve.cjs",
    "test": "nx run-many --targets=test:unit,test:compile",
    "test:browser": "nx run-many --targets=test:browser,test:e2e,test:visual",
    "test:browser:prepare": "pnpm exec playwright install --with-deps firefox webkit",
    "test:visual": "nx run-many --targets=test:visual",
    "watch": "nx watch --projects=\"$@\" --includeDependentProjects -- run nx build:deps \"$@\""
  },
  "simple-git-hooks": {
    "post-checkout": "pnpm install",
    "post-merge": "pnpm install",
    "pre-push": "pnpm lint"
  },
  "dependencies": {
    "eslint-scope": "^9.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lerna-lite/cli": "^5.3.0",
    "@lerna-lite/publish": "^5.3.0",
    "@nx/devkit": "^22.7.5",
    "@types/node": "^25.9.3",
    "@types/verror": "^1.10.11",
    "@types/yieldable-json": "^2.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.3",
    "depcheck": "^1.4.7",
    "dot-prop": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fs-jetpack": "^5.1.0",
    "nx": "^22.7.5",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-pkgsort": "^0.3.0",
    "prettier-plugin-sort-json": "^4.2.0",
    "react-docgen-typescript": "^2.4.0",
    "simple-git-hooks": "^2.13.1",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-plugin-logical-css": "^2.1.0",
    "stylelint-scss": "^7.2.0",
    "tsx": "^4.22.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.61.1",
    "verror": "^1.10.1",
    "yieldable-json": "^2.1.0"
  },
  "resolutions": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
